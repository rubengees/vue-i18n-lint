{
  "name": "vue-i18n-lint",
  "version": "0.1.0",
  "description": "Fast and accurate linting for Vue i18n.",
  "keywords": [
    "i18n",
    "lint",
    "vue"
  ],
  "license": "MIT",
  "author": "Ruben Gees",
  "repository": "rubengees/vue-i18n-lint",
  "bin": {
    "vue-i18n-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vitest",
    "start": "node src/cli.ts",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsgo --noEmit",
    "test": "vitest run",
    "bench": "vitest --run bench",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@vue/compiler-core": "^3.5.32",
    "@vue/compiler-sfc": "^3.5.32",
    "c12": "4.0.0-beta.5",
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "globby": "^16.2.0",
    "jiti": "^2.6.1",
    "oxc-parser": "^0.129.0",
    "table": "^6.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@types/babel__code-frame": "7.27.0",
    "@types/node": "22.19.19",
    "@typescript/native-preview": "7.0.0-dev.20260508.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "tsdown": "0.22.0",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}

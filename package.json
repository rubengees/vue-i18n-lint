{
  "name": "vue-i18n-lint",
  "version": "0.1.0",
  "description": "Fast and accurate linting for Vue i18n.",
  "keywords": [
    "i18n",
    "lint",
    "vue"
  ],
  "license": "MIT",
  "author": "Ruben Gees",
  "repository": "rubengees/vue-i18n-lint",
  "bin": {
    "vue-i18n-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vitest",
    "start": "node src/cli.ts",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsgo --noEmit",
    "test": "vitest run",
    "bench": "vitest --run bench",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@vue/compiler-core": "^3.5.32",
    "@vue/compiler-sfc": "^3.5.32",
    "c12": "4.0.0-beta.4",
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "globby": "^16.2.0",
    "jiti": "^2.6.1",
    "oxc-parser": "^0.128.0",
    "table": "^6.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.9",
    "@types/babel__code-frame": "7.27.0",
    "@types/node": "20.19.39",
    "@typescript/native-preview": "7.0.0-dev.20260501.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "oxlint-tsgolint": "0.22.1",
    "tsdown": "0.21.10",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}

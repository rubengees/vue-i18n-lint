{
  "name": "vue-i18n-lint",
  "version": "0.0.0",
  "description": "Fast and accurate linting for Vue i18n.",
  "keywords": [
    "i18n",
    "lint",
    "vue"
  ],
  "license": "MIT",
  "author": "Ruben Gees",
  "repository": "rubengees/vue-i18n-lint",
  "bin": {
    "vue-i18n-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vitest",
    "start": "jiti src/cli.ts",
    "build": "tsdown",
    "generate-schema": "jiti generate-schema.ts",
    "generate-schema:check": "jiti generate-schema.ts --check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest --run bench",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm generate-schema:check && pnpm test"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.6",
    "@stricli/core": "^1.3.0",
    "@toon-format/toon": "^4.1.1",
    "@vue/compiler-core": "^3.5.43",
    "@vue/compiler-sfc": "^3.5.43",
    "c12": "4.0.0-rc.4",
    "confbox": "^0.3.1",
    "defu": "^6.1.7",
    "globby": "^16.2.4",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.158.0",
    "regexp.escape": "^2.0.1",
    "table": "^6.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/babel__code-frame": "7.27.0",
    "@types/node": "22.20.5",
    "@types/regexp.escape": "2.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}

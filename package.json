{
  "name": "vue-i18n-lint",
  "version": "0.0.0",
  "description": "Fast and accurate linting for Vue i18n.",
  "keywords": [
    "i18n",
    "lint",
    "vue"
  ],
  "license": "MIT",
  "author": "Ruben Gees",
  "repository": "rubengees/vue-i18n-lint",
  "bin": {
    "vue-i18n-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vitest",
    "start": "jiti src/cli.ts",
    "build": "tsdown",
    "generate-schema": "jiti generate-schema.ts",
    "generate-schema:check": "jiti generate-schema.ts --check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest --run bench",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@stricli/core": "^1.2.9",
    "@toon-format/toon": "^4.0.0",
    "@vue/compiler-core": "^3.5.39",
    "@vue/compiler-sfc": "^3.5.39",
    "c12": "4.0.0-beta.5",
    "confbox": "^0.2.4",
    "defu": "^6.1.7",
    "globby": "^16.2.1",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.146.0",
    "regexp.escape": "^2.0.1",
    "table": "^6.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/babel__code-frame": "7.27.0",
    "@types/node": "22.20.1",
    "@types/regexp.escape": "2.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
